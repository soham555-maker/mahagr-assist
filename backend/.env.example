# --- LLM provider ---------------------------------------------------------
# Default is Groq (fast, hosted). For a fully on-premise / NIC deployment where
# no document leaves the machine, set LLM_PROVIDER=ollama and run a local model
# (retrieval, embeddings and reranking are already local either way).

# groq (default): needs a key, free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_key_here

# ollama (local): uncomment these, run `ollama serve` + `ollama pull <model>`.
# On a small GPU (e.g. 6 GB), use a ~3B model so it fits, and set EMBED_DEVICE=cpu
# so bge-m3 + the reranker leave the GPU free for the LLM.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b          # good multilingual, ~2 GB; or llama3.1:8b (~4.7 GB) if you have room
# EMBED_DEVICE=cpu                 # run embedder + reranker on CPU (frees GPU for Ollama)
